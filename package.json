{
  "name": "skyfall",
  "version": "1.0.0",
  "description": "Phaser 3 endless dodger with heat phases, bosses, perks, progression, tests, and Electron packaging.",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "test": "node --test",
    "test:e2e": "playwright test --project=chromium",
    "agents:plan": "./scripts/agents/launch_task_agents.sh --dry-run",
    "agents:launch": "./scripts/agents/launch_task_agents.sh",
    "agents:wave01": "./scripts/agents/launch_task_agents.sh --tasks-file tasks/launch/wave-01-docs-and-checklists.md",
    "agents:wave01:plan": "./scripts/agents/launch_task_agents.sh --tasks-file tasks/launch/wave-01-docs-and-checklists.md --dry-run",
    "agents:wave02": "./scripts/agents/launch_task_agents.sh --tasks-file tasks/launch/wave-02-isolated-small-code.md",
    "agents:wave02:plan": "./scripts/agents/launch_task_agents.sh --tasks-file tasks/launch/wave-02-isolated-small-code.md --dry-run",
    "agents:wave05:plan": "./scripts/agents/launch_task_agents.sh --tasks-file tasks/launch/wave-05-save-platform-online.md --dry-run",
    "dev": "vite",
    "dev:3000": "vite --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "electron:build": "vite build && electron-builder",
    "telemetry:aggregate": "node scripts/telemetry/aggregateTelemetry.js",
    "meta": "node scripts/generate-project-meta.mjs",
    "meta:check": "node scripts/generate-project-meta.mjs --check",
    "shots": "node scripts/capture-project-shots.mjs",
    "social": "node scripts/generate-social-preview.mjs",
    "social:check": "node scripts/generate-social-preview.mjs --check",
    "icons": "node scripts/generate-app-icons.mjs",
    "icons:check": "node scripts/generate-app-icons.mjs --check",
    "meta:refresh": "node scripts/refresh-project-meta.mjs",
    "trailers": "node scripts/build-project-trailers.mjs",
    "trailers:check": "node scripts/build-project-trailers.mjs --check"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "phaser": "^3.90.0",
    "phaser3-juice-plugin": "github:RetroVX/phaser3-juice-plugin#549cbddd6e7f950809a9c0bf04e1cfced176c9c5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "vite": "^6.4.1"
  },
  "build": {
    "appId": "com.skyfall.game",
    "productName": "Skyfall",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
